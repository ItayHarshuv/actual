{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2022", "DOM"],
    "types": ["node", "vitest/globals"],
    "strict": true,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "plugins": [{ "name": "typescript-strict-plugin", "paths": ["."] }]
  },
  "references": [{ "path": "../api" }, { "path": "../loot-core" }],
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "coverage", "src/**/*.test.ts"]
}
